{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-productivity-app",
  "version": "0.1.0",
  "identifier": "com.jerem.my-productivity-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOCK IN",
        "width": 800,
        "height": 600
      },
      {
        "label": "timer-popout",
        "title": "LOCK IN Timer",
        "url": "timer-popout.html",
        "width": 260,
        "height": 150,
        "minWidth": 220,
        "minHeight": 130,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "default": {
        "driver": "sqlite",
        "url": "sqlite:tasks.db"
      }
    }
  }
}
